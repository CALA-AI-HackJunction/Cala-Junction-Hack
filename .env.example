# ==============================================================================
# Unicorn Radar — Cala × Slush Connection Intelligence (Hackjunction 2026)
# Copy to `.env` (`cp .env.example .env`) and populate any optional cloud keys.
# NOTE: The entire core graph engine, deterministic Meeting Brief composer,
# SQLite store, and workspace CycloneDX SBOM inspector run 100% offline with
# ZERO API keys required! Keys below unlock live cloud enrichments & AI modes.
# ==============================================================================

# --- Server Binding ---
HOST=127.0.0.1
PORT=8080

# --- 1. Cala Knowledge Graph API (https://api.cala.ai/v1) ---
# Optional: Enables live `/api/cala/enrich/{entity_id}` structured lookups
# (`entity_search` -> `entity_introspection` -> projected `entity_retrieval`).
# Strictly isolated under `cala_live_enrichment` with full source provenance.
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai/v1
CALA_TIMEOUT_SECONDS=180

# --- 2. Google Gemini API (Primary Grounded Claim & Meeting Brief Composer) ---
# Optional: Powers citation-locked `generated_claims`, `meeting_brief`, and CRACI
# supply-chain audits (`composer_mode=gemini` or `gemini_gemma_audit`).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 3. Gemma Open-Weight Model (Claim Entailment & Zero-Confabulation Auditor) ---
# Supported GEMMA_PROVIDER values:
#   - `google_ai_studio`  (uses GEMMA_API_KEY or falls back to GEMINI_API_KEY via Google GenAI API)
#   - `featherless`       (uses FEATHERLESS_API_KEY or GEMMA_API_KEY at https://api.featherless.ai/v1)
#   - `openai_compatible` (uses GEMMA_API_KEY + GEMMA_BASE_URL, e.g. Ollama/vLLM/HuggingFace TGI)
GEMMA_PROVIDER=google_ai_studio
GEMMA_MODEL=gemma-3-27b-it
GEMMA_API_KEY=
FEATHERLESS_API_KEY=
GEMMA_BASE_URL=https://api.featherless.ai/v1

# --- 4. Aiven Managed Data Infrastructure (PostgreSQL + Valkey) ---
# Optional: When set, persists immutable analysis runs in Aiven PostgreSQL and
# caches canonical versioned query subgraphs in Aiven Valkey (< 2ms hits).
# Automatically falls back to local `backend/data/analyses.sqlite3` + Memory LRU when unset.
AIVEN_PG_URI=
AIVEN_VALKEY_URL=

# --- 5. CRACI CI/CD Provenance, CycloneDX SBOM & Egress Trace API ---
# Optional: Queries `https://api.craci.com` (`/v1preview1/jobs`, `/sbom`, `/network-trace`, `/usage`).
# Falls back cleanly to verified local workspace CycloneDX SBOM + `.github/workflows` inspection.
CRACI_API_TOKEN=
CRACI_ORG=
CRACI_REPO=
CRACI_BASE_URL=https://api.craci.com

# --- Legacy Optional Generic Composer Hook (100% Reference Spec Compatibility) ---
CALA_DEMO_COMPOSER_URL=
CALA_DEMO_COMPOSER_TOKEN=
