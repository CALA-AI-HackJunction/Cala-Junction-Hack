GEMINI_API_KEY=
GEMINI_AGENT_ID=cala-research-agent
CALA_CONNECTION_MODE=direct
GEMINI_MODEL=gemini-3.8-flash

# Runtime setting in direct mode. Sent only to Cala's MCP endpoint.
CALA_API_KEY=

# Required on Cloud Run. Generate a separate random value, at least 32 characters.
CHAT_SIGNING_KEY=

# Optional for local or standalone use. Cloud Run uses IAM by default.
APP_ACCESS_TOKEN=
